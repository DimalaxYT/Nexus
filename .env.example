DATABASE_URL="file:../db/custom.db"

# Base Turso (recommandée en production, indispensable sur le plan gratuit de Render) :
# créez une base libSQL (turso db create nexus), puis renseignez son adresse et un jeton.
# Laissez vide pour utiliser le fichier local ci-dessus.
# TURSO_DATABASE_URL="libsql://nexus-votre-organisation.turso.io"
# TURSO_AUTH_TOKEN="..."
# Options : TURSO_REPLICA=0 (pas de réplique locale), TURSO_AUTO_IMPORT=0 (pas d'import initial)
